 public static int findNumberOfSuperiorElements(int arr[], int n) {
       int count = 0;
        for(int i=0;i<n;i++){
           for(int j=i+1;j<n-1;j++){
               if(arr[i]<arr[j]){
                   count++;
                   break;
               }
           }
       }
        return count;
}


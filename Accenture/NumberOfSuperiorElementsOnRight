T.C : O(N^2), S.C : O(N)

public static int findNumberOfSuperiorElements(int arr[], int n) {
     int count = 0;
        for(int i=0;i<n;i++){
         boolean superior = true;
         for(int j=i+1;j<n;j++){
             if(arr[i]<=arr[j]){
                 superior = false;
                 break;
             }
         }
     
        if(superior){
            count++;
        }
    }
        return count;
}

T.C : O(N), S.C : O(N)

 public static int findNumberOfSuperiorElements(int arr[], int n) {
       int count = 1; // extreme right element is superior
       int max = arr[n-1];
        for(int i=n-2;i>=0;i--){
           if(arr[i]>max){
               count++;
               max = arr[i];
           }
       }
        return count;
        
}

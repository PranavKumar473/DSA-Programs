LU: Sorting_Merge Two Sorted SubArray
Success rate: 37.50%
Given a sorted arrays with N elements and 3 indices s, m and e such that subarray [s,m] is sorted, subarray [m+1,e] is sorted. Sort the subarray [s,e].

Note: s to m and then m+1 to e are continuous subarray

Input Format:
The first line contains integer n representing size of array
The second line contains n elements of array.
The third line contains 3 elements representing s,m and e index.

Output Format:
Print the array after sorting subarray [s,e] in a line separated by space

Constraints:
1<= N <= 10 ^ 6
1<= A[i] <=10 ^ 9

Sample test cases
Input
12
4 8 -1 2 6 9 11 3 4 7 13 0
2 6 9
Expected output
4 8 -1 2 3 4 6 7 9 11 13 0 


//Code: T.C: O(N), S.C: O(N)

import java.util.Scanner;
public class Main {
	static int[] mergeSortedSubArray(int[] arr, int s, int m, int e){
		int p1 = s;
		int p2 = m+1;
		int p3 = 0;
		int[] temp = new int[e-s+1];
		while(p1<=m && p2<=e){
			if(arr[p1]<arr[p2]){
              temp[p3] = arr[p1];
			  p1++;
			  p3++;
			}
			else{
			 temp[p3] = arr[p2];
			  p2++;
			  p3++;
			}
		}
		while(p1<=m){
			temp[p3]=arr[p1];
			p1++;
			p3++;
		}
		while(p2<=e){
			temp[p3]=arr[p2];
			p2++;
			p3++;
		}
		  //took help here
         int i = 0;
			 while(s<=e){
			   arr[s]  = temp[i];
			   s++;
			   i++;
			}
			return arr;
		 }
		 
	
	public static void main(String[] args) {
		// write your code here
		Scanner scan = new Scanner(System.in);
		int n = scan.nextInt();

		int[] arr = new int[n];
		for(int i=0;i<n;i++){
			arr[i] = scan.nextInt();
		}

		int s=scan.nextInt();
		int m=scan.nextInt();
		int e=scan.nextInt();

    arr = mergeSortedSubArray(arr,s,m,e);
		for(int i=0;i<arr.length;i++){
			System.out.print(arr[i]+" ");
		}
	}
}

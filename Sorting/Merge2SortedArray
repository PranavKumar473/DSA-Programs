LU: Sorting_Merge Two Sorted Array
Success rate: 33.85%
Given two sorted arrays with N and M elements. Merge them into one sorted array and Print them.

Input Format:
The first line contains two integers n and m representing the size of 2 arrays
The second line contains n elements of first array.
The third line contains m elements of second array.

Output Format:
Print the merged sorted array in a line separated by space

Constraints:
1<= N <= 10 ^ 6
1<= A[i] <=10 ^ 9

Sample test cases
Input
4 3
7 10 11 14
3 8 9
Expected output
3 7 8 9 10 11 14 

//Code T.C: O(N+M), S.C: O(N+M)
import java.util.Scanner; 
public class Main {

    static int[] merge(int[] arr1,int[] arr2){
	   int n = arr1.length;
	   int m = arr2.length;

	   int[] arr3 = new int[m+n];
       int p1=0;
	   int p2=0;
	   int p3=0;

	   while(p1<n && p2<m){
		 if(arr1[p1]<arr2[p2]){
			  arr3[p3] = arr1[p1];
			  p1++;
			  p3++;
		 }
		 else{
			 arr3[p3] = arr2[p2];
			 p2++;
			 p3++;
		 }
	   }
	   while(p1<n){
			arr3[p3] = arr1[p1];
			p1++;
			p3++;
	   }
	   while(p2<m){
	    	arr3[p3] = arr2[p2];
	    	p2++;
	    	p3++;
	   }
	   return arr3;
	}

	public static void main(String[] args) {
		// write your code here
		Scanner scan = new Scanner(System.in);
        int n = scan.nextInt();
		    int m = scan.nextInt();

		  int arr1[] = new int[n];
		  int arr2[] = new int[m];

      for(int i=0;i<n;i++){
			arr1[i] = scan.nextInt();
		}
		  for(int i=0;i<m;i++){
			arr2[i] = scan.nextInt();
		}
       int[] arr3 = merge(arr1,arr2);
	     for(int i=0;i<arr3.length;i++){
			  System.out.print(arr3[i]+" ");
		}
	}
}

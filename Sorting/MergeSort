LU: Sorting_Merge Sort
Success rate: 8.70%
Given an array arr[], sort the array using the merge sort algorithm. Merge sort is a divide-and-conquer algorithm that recursively splits the array into two halves, sorts each half, and then merges the sorted halves back together.

Input Format:
The first line contains an integer n, the size of the array.
The second line contains n space-separated integers representing the elements of the array.

Output Format:
Output the sorted array as a single line of space-separated integers.

Constraints:
1 <= N <= 10^5
1 <= arr[i] <= 10^5

Sample test cases
Input
5
4 2 1 3 5
Expected output
1 2 3 4 5 

//Code : T.C:O(NlogN), S.C: O(N)


import java.util.Scanner;

public class Main {

    static void merge(int[] arr, int[] temp, int s, int m, int e) {
        int p1 = s;
        int p2 = m + 1;
        int p3 = s;

        // Merge into temp array
        while (p1 <= m && p2 <= e) {
            if (arr[p1] <= arr[p2]) {
                temp[p3++] = arr[p1++];
            } else {
                temp[p3++] = arr[p2++];
            }
        }

        // Copy remaining elements
        while (p1 <= m) {
            temp[p3++] = arr[p1++];
        }
        while (p2 <= e) {
            temp[p3++] = arr[p2++];
        }

        // Copy back to original array
        for (int i = s; i <= e; i++) {
            arr[i] = temp[i];
        }
    }

    static void mergeSort(int[] arr, int[] temp, int s, int e) {
        if (s >= e) {
            return;
        }

        int m = s + (e - s) / 2;

        mergeSort(arr, temp, s, m);
        mergeSort(arr, temp, m + 1, e);
        merge(arr, temp, s, m, e);
    }

    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        
        // Safety check to prevent reading errors
        if (!scan.hasNextInt()) {
            return; 
        }
        
        int n = scan.nextInt();
        int[] arr = new int[n];
        int[] temp = new int[n]; // Single memory allocation

        for (int i = 0; i < n; i++) {
            arr[i] = scan.nextInt();
        }

        // Run the sort
        mergeSort(arr, temp, 0, n - 1);

        // Fast print WITH trailing space
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i++) {
            sb.append(arr[i]).append(" "); 
        }
        System.out.println(sb.toString());
        
        scan.close();
    }
}



















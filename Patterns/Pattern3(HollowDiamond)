Pattern for n = 5.

*** ***  
**   **  
*     *  
**   **  
*** ***  

         int nst = n/2+1;
		 int nsp = 1;
		 
		 for(int i=1;i<=n;i++){
			for(int j=1;j<=nst;j++){
				System.out.print("*");   // Left side of stars
			}
			for(int j=1;j<=nsp;j++){
				System.out.print(" ");
			}
			for(int j=1;j<=nst;j++){
				System.out.print("*");   // Right side of stars
			}
			if(i<=n/2){
				nst--;
				nsp += 2;
			}else{
				nst++;
				nsp -= 2;
			}
			System.out.println();
		 }
	}
}

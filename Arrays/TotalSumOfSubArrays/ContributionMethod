static void SumOfSubArrays(int[] arr){
		int n = arr.length;
		int totalSum =0;
		for(int i=0;i<n;i++){
			for(int j=i;j<n;j++){
				 int sum = 0;
				 for(int k=i;k<=j;k++){
                  sum += arr[k];
				}
				totalSum += sum;
			}	
		}
		System.out.println(totalSum);
	}
    

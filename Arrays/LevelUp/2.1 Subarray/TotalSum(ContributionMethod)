2.1 Better 1(of choice) : T.C: O(N^2), S.C:O(1)         || total sum wala

 static void SumOfSubArrays(int[] arr){
		int n = arr.length;
	    int totalSum=0;
		for(int i=0;i<n;i++){
			int sum =0;                     // sum starts from 0 after loop is done
			for(int j=i;j<n;j++){
                  sum +=  arr[j];        
				  totalSum += sum;         // totalSum keeps hold of all previous sum
				}	
			}
			System.out.println(totalSum);	 // scope reachable	
		}

2.2 Better 2:  T.C: O(N^2), S.C: O(N) - Auxillary        || prefix sum wala 

static void PrintAllSubArrays(int[] arr){
	    int n = arr.length;
        int[] prefix = new int[n];
        prefix[0] = arr[0];
        for(int i=1;i<n;i++){
            prefix[i] = prefix[i-1] + arr[i];
        }
        int sum = 0;
		for(int i=0;i<n;i++){
          for(int j=i;j<n;j++){
             sum = (i==0)? sum + prefix[j]:sum + prefix[j] - prefix[i-1];
             }
	    }
        System.out.print(sum+" ");
	} 

// Code 
1. Brute Force (Worst) : T.C : O(N^3), S.C: O(1)       ||3 loop wala

static void SumOfSubArrays(int[] arr){
		int n = arr.length;
		int totalSum =0;
		for(int i=0;i<n;i++){            // loop1 sets start point
			for(int j=i;j<n;j++){        // loop2 depends on i for start point and runs till end
				 int sum = 0;
				 for(int k=i;k<=j;k++){  // loop 3 runs from i(fixed) to j(from i till end)
                  sum += arr[k];         // stores sum of one complete loop and when loop finishes it handsover the value to total sum 
				}
				totalSum += sum;         // total sum keeps aggregating values until i finishes and finally prints it.
			}	
		}
		System.out.println(totalSum);
	}

2. Fast I/O Optimization (For Online Judges)In competitive programming, standard Scanner and System.out.print are 
usually what cause time limit issues (TLE) on large inputs ($N \ge 1000$), not the matrix algorithm itself.
Using BufferedReader and StringBuilder cuts down the I/O bottleneck significantly:


import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.util.StringTokenizer;

public class Main {
    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int n = Integer.parseInt(br.readLine().trim());
        int[][] arr = new int[n][n];

        for (int i = 0; i < n; i++) {
            StringTokenizer st = new StringTokenizer(br.readLine());
            for (int j = 0; j < n; j++) {
                arr[i][j] = Integer.parseInt(st.nextToken());
            }
        }

        // Rotate in-place (Transpose + Reverse)
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < i; j++) {
                int temp = arr[i][j];
                arr[i][j] = arr[j][i];
                arr[j][i] = temp;
            }
        }
        for (int i = 0; i < n; i++) {
            int sp = 0, ep = n - 1;
            while (sp < ep) {
                int temp = arr[i][sp];
                arr[i][sp] = arr[i][ep];
                arr[i][ep] = temp;
                sp++; ep--;
            }
        }

        // Fast Output Buffer
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                sb.append(arr[i][j]).append(" ");
            }
            sb.append("\n");
        }
        System.out.print(sb);
    }
}





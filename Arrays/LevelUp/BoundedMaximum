	public static void main(String[] args) {
		// write your code here
		Scanner scan = new Scanner(System.in);
		int n = scan.nextInt();
		int[] nums = new int[n];

		for(int i=0;i<n;i++){
			nums[i] = scan.nextInt();
		}
		int left  = scan.nextInt();
		int right = scan.nextInt();

    boundedMaximum(nums,left,right);
	}
}













   	 static void boundedMaximum(int[] nums, int left, int right){
		int n = nums.length;
		int count = 0;
		for(int i=0;i<n;i++){
       	int ans = Integer.MIN_VALUE;
		   for(int j=i;j<n;j++){
        	ans = Math.max(ans,nums[j]);
            if(ans>=left && ans<=right){
			  count++;
			 }
		   }
        }
	    System.out.println(count); 
	}

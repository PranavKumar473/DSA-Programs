import java.util.*;
public class Main {
   static void nonRepeatingElement(int[]arr){
		HashMap<Integer,Integer> hm = new HashMap<>();
	int n=arr.length;
	for(int i=0;i<n;i++){
			if(hm.containsKey(arr[i])==false){
				hm.put(arr[i],1);
			}else{
				int count = hm.get(arr[i]);
				 hm.put(arr[i],count+1);
			}
		}

		for(int i=0;i<n;i++){
			if(hm.get(arr[i])==1){
				System.out.println(arr[i]);
				return;
			}
		}
		//return -1;
		System.out.println("-1");
	}
	

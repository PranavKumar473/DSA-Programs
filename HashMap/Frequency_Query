import java.util.*;
public class Main {
    static void frequency(int arr[],int queries[]){
		HashMap<Integer,Integer> hm = new HashMap<>();

		for(int i=0;i<arr.length;i++){
			if(hm.containsKey(arr[i])==false){
				hm.put(arr[i],1);
			}else{
				int temp = hm.get(arr[i]);
				hm.put(arr[i],temp+1);
			}
		}
		for(int i=0;i<queries.length;i++){
			if(hm.containsKey(queries[i])==false){
				System.out.println("0");
			}else{
				int count = hm.get(queries[i]);
				System.out.println(count);
			}
		}
	}


	public static void main(String[] args) {
		// write your code here
    Scanner scan = new Scanner(System.in);
    int size_of_array = scan.nextInt();
	int no_of_queries = scan.nextInt();

    int[] arr = new int[size_of_array];
    int[] queries = new int[no_of_queries];

	for(int i=0;i<size_of_array;i++){
		arr[i] = scan.nextInt();
	}
    
	for(int i=0;i<no_of_queries;i++){
		queries[i] = scan.nextInt();
	}

	frequency(arr,queries);
    scan.close();


	}
}
